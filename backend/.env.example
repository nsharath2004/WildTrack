# WildTrack Environment Configuration Template
# Copy this file to .env and adjust credentials as appropriate for your environment.

# Flask Application Secret Key for JWT token signing
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production

# MySQL Database Connection Credentials
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=replace-with-your-mysql-password
MYSQL_DATABASE=wildlife_management

# Authentication Settings
JWT_ACCESS_TOKEN_EXPIRES_HOURS=12

# ChromaDB Vector Storage Directory
CHROMA_PERSIST_DIRECTORY=../vector_database/chroma_data
